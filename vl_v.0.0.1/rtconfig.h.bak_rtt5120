/* tools packages */

#define PKG_USING_SEGGER_RTT
#define SEGGER_RTT_ENABLE
#define SEGGER_RTT_MAX_NUM_UP_BUFFERS 3
#define SEGGER_RTT_MAX_NUM_DOWN_BUFFERS 3
#define BUFFER_SIZE_UP 5120
/* 【2026-10-27 · P2】16 → 128
 *
 * 原值 16 的有效容量只有 15 B（SizeOfBuffer − 1，因 WrOff == RdOff 表示空，
 * 必须留 1 字节区分满/空）。而主机一次敲入的整行命令会被 RTT 一次性写入
 * 下行缓冲，17 字符的 "t_mech_set 1 1 42" 就装不下；配合
 * SEGGER_RTT_MODE_NO_BLOCK_SKIP（空间不足时**整段丢弃**，不做部分写入，
 * SEGGER_RTT.c:1029-1040），表现为"输入的命令没反应"，需等 idle 把缓冲
 * 抽空后再敲一次。128 B 可容纳 127 B 单行输入，覆盖现有全部 MSH 命令。
 * 注意：此宏必须与 .config 的 CONFIG_BUFFER_SIZE_DOWN 同步，否则
 * menuconfig 保存时会被回写成旧值。 */
#define BUFFER_SIZE_DOWN 128
#define SEGGER_RTT_PRINTF_BUFFER_SIZE 64
#define RTT_DEFAULT_BUFFER_INDEX 0
#define RTT_DEFAULT_TERMINAL_INDEX 0
#define PKG_USING_SEGGER_RTT_LATEST_VERSION
