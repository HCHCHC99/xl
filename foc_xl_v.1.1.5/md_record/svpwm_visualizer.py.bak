                    fg="#555", bg=self.colors['bg']).pack(side=tk.LEFT, padx=(0, 8))
        
        self.canvas = SVPWMCanvas(canvas_frame, width=550, height=560)
        self.canvas.pack(fill=tk.BOTH, expand=True)
        
        # ===== 底部状态栏 =====
