    def on_dir_change(self):
        if self.dir_var.get() == "正转":
            self.direction = 1
        else:
            self.direction = -1
        self.status_bar.config(text=f"转向切换为: {self.dir_var.get()}")
        self.execute()
    
    def on_unit_change(self):
        unit = self.unit_var.get()
        try:
            for entry in [self.est_entry, self.real_entry]:
                val = float(entry.get())
                if unit == "deg":
                    new_val = math.degrees(val)
                else:
                    new_val = math.radians(val)
                entry.delete(0, tk.END)
                entry.insert(0, f"{new_val:.4f}")
        except:
            pass
        self.status_bar.config(text=f"单位切换为: {'度' if unit == 'deg' else '弧度'}")
    
    def load_example(self):
        """加载示例"""
        self.log("加载示例...")
        self.dir_var.set("正转")
        self.direction = 1
        
        self.d_entry.delete(0, tk.END)
        self.d_entry.insert(0, "0.0")
        self.q_entry.delete(0, tk.END)
        self.q_entry.insert(0, "0.7")
        self.est_entry.delete(0, tk.END)
        self.est_entry.insert(0, "45.0")
        self.real_entry.delete(0, tk.END)
        self.real_entry.insert(0, "20.0")
        self.speed_entry.delete(0, tk.END)
        self.speed_entry.insert(0, "50.0")
        self.step_entry.delete(0, tk.END)
        self.step_entry.insert(0, "5.0")
        
        self.reset_accumulation()
        self.status_bar.config(text="已加载示例: 正转 · 初始角度误差25°，可模拟累积")
        self.root.after(100, self.execute)
    
    def reset_params(self):
        self.d_entry.delete(0, tk.END)
        self.d_entry.insert(0, "0.0")
        self.q_entry.delete(0, tk.END)
        self.q_entry.insert(0, "0.0")
        self.est_entry.delete(0, tk.END)
        self.est_entry.insert(0, "0.0")
        self.real_entry.delete(0, tk.END)
        self.real_entry.insert(0, "0.0")
        self.reset_accumulation()
        self.status_bar.config(text="参数已重置")
        self.execute()
    
    def reset_accumulation(self):
        """重置误差累积"""
        self.error_accumulated = 0.0
        self.step_count = 0
        self.is_diverging = False
        self.accum_status.config(text="累积: 0.0° | 步数: 0 | 状态: 安全", fg="#00AA00")
        self.log(f"误差累积已重置")
    
    def toggle_simulation(self):
        """切换模拟运行状态"""
        if self.sim_running:
            self.stop_simulation()
        else:
            self.start_simulation()
    
    def start_simulation(self):
        """开始误差累积模拟"""
        self.sim_running = True
        self.sim_btn.config(text="⏹ 停止模拟", bg="#e74c3c")
        self.status_bar.config(text="模拟运行中... 观察角度误差累积过程")
        self.log("模拟开始")
        self.sim_step()
    
    def stop_simulation(self):
        """停止模拟"""
        self.sim_running = False
        if self.sim_timer:
            self.root.after_cancel(self.sim_timer)
            self.sim_timer = None
        self.sim_btn.config(text="▶ 开始模拟", bg=self.colors['success'])
        self.status_bar.config(text="模拟已停止")
        self.log("模拟停止")
    
    def sim_step(self):
        """执行一步模拟"""
        if not self.sim_running:
            return
        
        try:
            speed = float(self.speed_entry.get())
            step_deg = float(self.step_entry.get())
            
            est_val = float(self.est_entry.get())
            real_val = float(self.real_entry.get())
            
            self.step_count += 1
            
            real_val += step_deg
            est_val += step_deg
            
            d = float(self.d_entry.get())
            q = float(self.q_entry.get())
            
            est_rad = math.radians(est_val)
            real_rad = math.radians(real_val)
            
            result = SguanMath.svpwm(d, q, est_rad)
            _, _, _, _, alpha, beta = result
            v_angle = math.atan2(beta, alpha)
            
            delta_real = v_angle - real_rad
            while delta_real > math.pi:
                delta_real -= 2 * math.pi
            while delta_real < -math.pi:
                delta_real += 2 * math.pi
            delta_deg = math.degrees(delta_real)
            
            current_error = est_val - real_val
            self.error_accumulated += abs(current_error * 0.1)
            
            if abs(delta_deg) > 60:
                self.is_diverging = True
            
            self.est_entry.delete(0, tk.END)
            self.est_entry.insert(0, f"{est_val:.2f}")
            self.real_entry.delete(0, tk.END)
            self.real_entry.insert(0, f"{real_val:.2f}")
            
            if self.is_diverging:
                color = "#FF0000"
                status = "发散中！"
            elif self.error_accumulated > 30:
                color = "#FF6600"
                status = "误差较大"
            else:
                color = "#00AA00"
                status = "安全"
            
            self.accum_status.config(
                text=f"累积: {self.error_accumulated:.1f}° | 步数: {self.step_count} | 状态: {status}",
                fg=color
            )
            
            self.execute()
            
            if self.is_diverging and abs(delta_deg) > 90:
                self.status_bar.config(text="已失步！模拟自动停止")
                self.stop_simulation()
                return
            
            self.sim_timer = self.root.after(200, self.sim_step)
            
        except Exception as e:
            self.log(f"模拟步进错误: {e}")
            self.stop_simulation()
    
    def execute(self):
        """执行计算并更新显示"""
        self.log("=" * 50)
        self.log("执行计算开始...")
        
        try:
            d = float(self.d_entry.get().strip())
            q = float(self.q_entry.get().strip())
            angle_est_val = float(self.est_entry.get().strip())
            angle_real_val = float(self.real_entry.get().strip())
            
            if self.unit_var.get() == "deg":
                angle_est = math.radians(angle_est_val)
                angle_real = math.radians(angle_real_val)
            else:
                angle_est = angle_est_val
                angle_real = angle_real_val
            
            result = SguanMath.svpwm(d, q, angle_est)
            d_u, d_v, d_w, sector, alpha, beta = result
            
            self.canvas.update_vectors(
                d, q, angle_est, angle_real, alpha, beta, sector, self.direction,
                self.error_accumulated, self.step_count, self.is_diverging
            )
            
            v_angle = math.atan2(beta, alpha)
            delta_real = v_angle - angle_real
            while delta_real > math.pi:
                delta_real -= 2 * math.pi
            while delta_real < -math.pi:
                delta_real += 2 * math.pi
            
            angle_error = angle_est - angle_real
            while angle_error > math.pi:
                angle_error -= 2 * math.pi
            while angle_error < -math.pi:
                angle_error += 2 * math.pi
            
            self.update_result(d, q, angle_est, angle_real, alpha, beta, sector,
                             d_u, d_v, d_w, v_angle, delta_real, angle_error)
            
            delta_deg = math.degrees(delta_real)
            dir_text = "正转" if self.direction == 1 else "反转"
            
            if self.direction == 1 and delta_real < 0:
                status = "推力模式"
            elif self.direction == -1 and delta_real > 0:
                status = "推力模式"
            elif abs(delta_deg) > 80:
                status = "接近失步"
            elif abs(delta_deg) > 60:
                status = "功角偏大"
            else:
                status = "安全"
            
            self.status_bar.config(
                text=f"{dir_text} | δ={delta_deg:+.1f}° | 误差累积={self.error_accumulated:.1f}° | {status}"
            )
            
        except ValueError as e:
            self.log(f"ValueError: {e}")
            self.status_bar.config(text="输入错误")
        except Exception as e:
            self.log(f"执行错误: {e}")
            self.log(traceback.format_exc())
            self.status_bar.config(text=f"错误: {str(e)}")
        
        self.log("执行计算结束")
        self.log("=" * 50)
    
    def update_result(self, d, q, angle_est, angle_real, alpha, beta, sector,
                     d_u, d_v, d_w, v_angle, delta_real, angle_error):
        """更新结果显示"""
        try:
            self.result_text.config(state=tk.NORMAL)
            self.result_text.delete(1.0, tk.END)
            
            theta_est_deg = math.degrees(angle_est)
            theta_real_deg = math.degrees(angle_real)
            v_angle_deg = math.degrees(v_angle)
            delta_deg = math.degrees(delta_real)
            error_deg = math.degrees(angle_error)
            dir_text = "正转" if self.direction == 1 else "反转"
            
            lines = []
            lines.append("═" * 50)
            lines.append(" 输入参数")
            lines.append("─" * 50)
            lines.append(f"  转向       → {dir_text}")
            lines.append(f"  d = {d:+.4f}  (径向力/励磁)")
            lines.append(f"  q = {q:+.4f}  (切向力/力矩)")
            lines.append(f"  θ_est      → {theta_est_deg:+.1f}°")
            lines.append(f"  θ_real     → {theta_real_deg:+.1f}°")
            lines.append(f"  当前角度误差 → {error_deg:+.1f}°")
            lines.append("")
            lines.append("─" * 50)
            lines.append(" 输出结果")
            lines.append("─" * 50)
            lines.append(f"  扇区     → {sector}")
            lines.append(f"  d_u      → {d_u:.4f}  ({d_u*100:.1f}%)")
            lines.append(f"  d_v      → {d_v:.4f}  ({d_v*100:.1f}%)")
            lines.append(f"  d_w      → {d_w:.4f}  ({d_w*100:.1f}%)")
            lines.append("")
            lines.append("─" * 50)
            lines.append(" 功角与受力分析")
            lines.append("─" * 50)
            lines.append(f"  V_ref    → {v_angle_deg:+.1f}° (定子磁场)")
            lines.append(f"  真实d轴  → {theta_real_deg:+.1f}° (N极)")
            lines.append(f"  δ_real   → {delta_deg:+.1f}°")
            
            if self.direction == 1:
                if delta_real > 0:
                    lines.append(f"  正转·拉力模式 (δ>0)")
                    lines.append(f"     V_ref 在 N极 前方拉着走")
                else:
                    lines.append(f"  正转·推力模式 (δ<0)")
                    lines.append(f"     V_ref 在 N极 后方推着走")
                    lines.append(f"     → 力矩方向错误！")
            else:
                if delta_real < 0:
                    lines.append(f"  反转·拉力模式 (δ<0)")
                else:
                    lines.append(f"  反转·推力模式 (δ>0)")
                    lines.append(f"     → 力矩方向错误！")
            
            lines.append("")
            lines.append("─" * 50)
            lines.append(" 误差累积状态")
            lines.append("─" * 50)
            lines.append(f"  累积误差   → {self.error_accumulated:.1f}°")
            lines.append(f"  步数       → {self.step_count}")
            
            if self.is_diverging:
                lines.append(f"  状态    → 发散中！")
                lines.append(f"     → 角度误差不断增大")
                lines.append(f"     → 力矩方向持续错误")
                lines.append(f"     → 最终将导致失步！")
            elif self.error_accumulated > 30:
                lines.append(f"  状态    → 误差较大")
                lines.append(f"     → 需要检查角度观测器")
            else:
                lines.append(f"  状态    → 安全")
            
            if abs(delta_deg) > 80:
                lines.append("")
                lines.append("  ⚠️ 严重：功角过大，接近失步！")
            elif abs(delta_deg) > 60:
                lines.append("")
                lines.append("  ⚡ 警告：功角偏大，力矩效率降低")
            else:
                lines.append("")
                lines.append("  功角安全，运行正常")
            
            lines.append("═" * 50)
            
            output = "\n".join(lines)
            self.result_text.insert(1.0, output)
            self.result_text.config(state=tk.DISABLED)
        except Exception as e:
            self.log(f"update_result错误: {e}")


# ============ 独立运行入口 ============
if __name__ == "__main__":
    print("=" * 60)
    print("启动 SVPWM 可视化工具 (含误差累积模拟)...")
    print(f"Python 版本: {sys.version}")
    print("=" * 60)
    
    try:
        root = tk.Tk()
        print("Tkinter 根窗口创建成功")
        
        app = SVPWMApp(root)
        print("SVPWMApp 实例创建成功")
        
        print("进入主事件循环...")
        print("=" * 60)
        root.mainloop()
        print("程序正常退出")
    except Exception as e:
        print(f"程序启动失败: {e}")
        traceback.print_exc()
        input("\n按 Enter 键退出...")