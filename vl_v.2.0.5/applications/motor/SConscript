from building import *

cwd = GetCurrentDir()
src = Glob('*.c') + Glob('drv/*.c') + Glob('fb/*.c') + Glob('ctrl/*.c') + Glob('foc/*.c')

CPPPATH = [
    cwd,
    cwd + '/drv',
    cwd + '/fb',
    cwd + '/ctrl',
    cwd + '/foc',
    '..',
    '../framework/core',
    '../framework/manager',
    '../hw',
    '../bsp',
    '../storage',
    '../sys_param',
]

group = DefineGroup('Motor', src, depend = [''], CPPPATH = CPPPATH)
Return('group')